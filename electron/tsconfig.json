{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "../dist-electron",
    "rootDir": "./",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "types": ["node", "electron"],
    "isolatedModules": false
  },
  "include": [
    "main.ts",
    "preload.ts",
    "database.ts",
    "db.ts",
    "handlers.ts",
    "api/*.ts",
    "prisma-client.ts"
  ],
  "exclude": [
    "node_modules",
    "../dist",
    "../dist-electron",
    "../.next",
    "../src/app",
    "../src/components"
  ]
}
